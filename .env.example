# Compose reads .env; native Go reads the shell environment.
PORT=8080
HOST_PORT=8080
DATABASE_PATH=Real-Time-Forum.db
# UPLOAD_PATH defaults to an uploads directory beside DATABASE_PATH.
# Compose uses /data/forum.db and /data/uploads in its persistent volume.
PUBLIC_ORIGIN=http://localhost:8080
COOKIE_SECURE=false
# Native HTTPS: set both paths. HTTPS automatically enables Secure cookies.
TLS_CERT_FILE=
TLS_KEY_FILE=
# Compose HTTPS overlay mounts this directory at /certs.
TLS_CERT_DIR=./.local
FORUM_PREMODERATE=false
# Optional existing administrator IDs. Local cmd/admin is preferred.
ADMIN_USER_IDS=
# Both credentials enable a provider. Providers require an HTTPS PUBLIC_ORIGIN.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
